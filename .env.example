SHOWROOM_ACCOUNT_ID=
SHOWROOM_PASSWORD=
# カンマ区切りで指定すると config.yaml の rooms より優先されます
SHOWROOM_ROOMS=
# 視聴はせず、配信が始まったら一度だけ入室するルーム。カンマ区切り
SHOWROOM_ENTER_ROOMS=
# 視聴せずギフトだけ記録するルームとイベント。カンマ区切り。件数の上限はない
SHOWROOM_RECORD_ROOMS=
SHOWROOM_EVENTS=
# 応援しているルーム (「分析」の基準) と、ギフターを調べるルーム (カンマ区切り)。視聴はせず、累計ポイント
# ランキングとイベントの貢献ランキングを毎日集める。管理画面の「ルーム設定」でも変えられる
SHOWROOM_SUPPORT_ROOMS=
SHOWROOM_RESEARCH_ROOMS=
# SHOWROOM_RESEARCH_DAYS=毎日                 # 情報を集める曜日 (mon〜sun / 月〜日 をカンマ区切り、毎日)
# SHOWROOM_RESEARCH_TIMES=4:30                 # 情報を集める時刻 (日本時間)
# SHOWROOM の全ルームの情報を少しずつ集め続ける (配信中・イベント参加のルームを見つけて、累計ランキングと
# 終わったイベントの貢献ランキングを取る)。state/research.db が数百 MB〜1GB 程度になる (ディスクの空きに注意)
# SHOWROOM_RESEARCH_ALL=true
# SHOWROOM_RESEARCH_SCAN=true                  # ルーム番号を 1 から順に 1 回だけ調べる (約 58 万回)
# SHOWROOM_RESEARCH_GAP=1.0                    # 問い合わせの間隔 (秒)。混んでいれば自動で広げる
# 管理画面のパスワード (localhost 以外から開く場合のみ必要)
SHOWROOM_WEB_PASSWORD=

# config.example.yaml のどの項目も SHOWROOM_<項目名を大文字> で指定できます (サーバーの Docker では config.yaml を読まないため)
# 例:
# SHOWROOM_LOGIN_CHECK_INTERVAL=7200        # ログイン確認の間隔 (秒)
# SHOWROOM_SAVE_STATE_MINUTES=10            # セッションの保存間隔 (分)
# SHOWROOM_PERIODIC_RELOAD_MINUTES=60       # 定期リロードの間隔 (分)。0 で無効
# SHOWROOM_KEEP_OPEN_WHEN_OFFLINE=auto      # 配信していないルームのページも開いておくか (true / false / auto)
# SHOWROOM_VIDEO_QUALITY=medium             # 視聴する画質 (low / medium / original / auto)。medium は再生枠と同じ大きさで CPU が最も軽い
# SHOWROOM_GIFT_UPDATE_DAYS=mon             # ギフトの一覧を取り直す曜日 (mon〜sun / 月〜日 をカンマ区切り、毎日 も可)
# SHOWROOM_GIFT_UPDATE_TIMES=0:00,3:00,12:00,15:00,18:00  # 取り直す時刻 (日本時間)。起動時にも取り直す
# SHOWROOM_BACKGROUND_TABS=true             # 配信ページを空白のページの裏に開いて CPU を減らす (約 3 割)
